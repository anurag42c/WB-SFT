<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- PULL mode: switched OFF by default. Enable it only if Odoo can reach the weighbridge URL (wb.api_url). -->
    <record id="cron_wb_pull_tickets" model="ir.cron">
        <field name="name">Weighbridge: fetch new tickets</field>
        <field name="model_id" ref="model_wb_ticket"/>
        <field name="state">code</field>
        <field name="code">model._cron_pull_tickets()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
